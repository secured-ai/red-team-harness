{
  "name": "red-team-harness",
  "version": "0.1.0",
  "description": "Run the SecuredAI agent probe set against a live deployment and report the outcome to the certification register.",
  "license": "Apache-2.0",
  "type": "module",
  "bin": {
    "red-team-harness": "./src/cli.ts"
  },
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "README.md"
  ],
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "test": "node --test test/*.test.ts",
    "typecheck": "tsc -p tsconfig.json",
    "probe": "node src/cli.ts probe"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/secured-ai/red-team-harness.git"
  },
  "homepage": "https://securedai.org/products",
  "bugs": {
    "url": "https://github.com/secured-ai/red-team-harness/issues"
  },
  "keywords": [
    "ai-security",
    "prompt-injection",
    "red-team",
    "agent",
    "llm"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2"
  }
}
