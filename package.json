{
  "name": "red-team-harness",
  "version": "0.2.0",
  "description": "Run the SecuredAI agent probe set against a live deployment and report the outcome to the certification register.",
  "license": "Apache-2.0",
  "author": "SecuredAI.org",
  "type": "module",
  "bin": {
    "red-team-harness": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "node --test test/*.test.ts",
    "demo": "node src/cli.ts demo",
    "probe": "node src/cli.ts probe",
    "smoke": "node tools/consumer-smoke.mjs",
    "prepack": "npm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/secured-ai/red-team-harness.git"
  },
  "homepage": "https://securedai.org/products",
  "bugs": {
    "url": "https://github.com/secured-ai/red-team-harness/issues"
  },
  "keywords": [
    "ai-security",
    "prompt-injection",
    "red-team",
    "agent",
    "llm"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "^7.0.2"
  }
}
